FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime@sha256:831247999fbf7e08f61b3e39f6d77ee434f38f6f07f769d00db451e853878067
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8 \
    HF_HUB_DISABLE_XET=1 HF_HOME=/models/huggingface MODELSCOPE_CACHE=/models/modelscope \
    LD_LIBRARY_PATH=/opt/conda/lib:/usr/local/cuda/lib64
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates
WORKDIR /app
COPY requirements-gpu.txt /app/requirements-gpu.txt
COPY requirements-gpu.lock /app/requirements-gpu.lock
COPY wheelhouse /wheels
RUN pip install --no-index --no-build-isolation --find-links=/wheels -r requirements-gpu.txt -c requirements-gpu.lock
RUN pip check
ENV LD_LIBRARY_PATH=/opt/conda/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/conda/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
COPY v2t /app/v2t
COPY config /app/config
COPY build_tools /app/build_tools
RUN useradd --uid 1000 --create-home app && install -d -o app -g app /results /media /models /database
USER app
ENV SERVICE_ROLE=gpu
CMD ["python", "-m", "v2t.service"]
