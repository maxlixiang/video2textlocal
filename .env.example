# 复制为 .env.test，并在本机编辑；只使用独立测试机器人。
BOT_PURPOSE=test
EXPECTED_TEST_BOT_ID=
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120
DEEPSEEK_THINKING=disabled
DEEPSEEK_CONTEXT_TOKENS=8192
DEEPSEEK_OUTPUT_TOKENS=4096
POLISH_CHUNK_TOKENS=1800
PROMPT_VERSION=faithful-v1
HOTWORDS=涉外律师 涉外法律 出海 合规 尽职调查
# 词表默认读取新项目 config/hotwords.txt；每行一个条目，支持英文多词名称。
# HOTWORDS_FILE=/app/config/hotwords.txt
# DEEPSEEK_TERMS_FILE=/app/config/terms.txt
# DEEPSEEK_TERM_ALIASES_FILE=/app/config/term-aliases.json
MAX_MEDIA_BYTES=524288000
MAX_MEDIA_SECONDS=7200
DOWNLOAD_TIMEOUT=600
DOUYIN_BROWSER_TIMEOUT_SECONDS=60
ASR_TIMEOUT=7200
QUEUE_LIMIT=20
WHISPER_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf

WINDOWS_ADAPTER_ENABLED=0
ADAPTER_QUEUE_SECONDS=300
ADAPTER_EXECUTION_SECONDS=600
ADAPTER_LINUX_QUOTA_BYTES=8589934592
ADAPTER_MIN_FREE_BYTES=2147483648

# Completed-task media only; manuscripts/models/failed tasks are preserved.
MEDIA_RETENTION_DAYS=3
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
